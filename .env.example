# ─────────────────────────────────────────────
# Configuration de l'environnement
# Copier ce fichier en .env et adapter les valeurs
# ─────────────────────────────────────────────

# MinIO (Data Lake)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin


# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ARTICLES=news-articles-raw

# Data Warehouse PostgreSQL
DW_HOST=datawarehouse
DW_PORT=5432
DW_NAME=newsdb
DW_USER=dwuser
DW_PASSWORD=dwpass

# Superset
SUPERSET_SECRET_KEY=change_me_in_production_xyz789

# Airflow
AIRFLOW_ADMIN_PASSWORD=admin

# Scraping — délai entre requêtes (secondes)
SCRAPE_DELAY=2
SCRAPE_BATCH_INTERVAL_HOURS=1
